---
import BaseLayout from "../layouts/BaseLayout.astro";
import VideoEmbed from "../components/VideoEmbed.astro";
import ImageSlot from "../components/ImageSlot.astro";
import { site, services, stats, quotes } from "../data/site";
import { getCollection } from "astro:content";

const featuredVideo = (await getCollection("videos"))
  .filter((v) => v.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
---

<BaseLayout
  title="Enter-Great 313 | Reentry Support for Returning Citizens in Detroit"
  description="Detroit nonprofit helping returning citizens rebuild after incarceration — weekly peer support groups, mentorship, job training, and reentry resources. Donate, come to a meeting, or write a letter of support."
>
  <section class="bg-stone-50">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 lg:grid-cols-2 lg:py-24">
      <div>
        <h1 class="text-4xl font-extrabold leading-tight tracking-tight text-emerald-950 sm:text-5xl">
          Rebuilding lives with support and opportunity.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-stone-700">
          {site.mission}
        </p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a href="/donate" class="rounded-md bg-emerald-800 px-6 py-3 text-lg font-semibold text-white hover:bg-emerald-700">
            Donate Now
          </a>
          <a href="/letters" class="rounded-md border-2 border-emerald-800 px-6 py-3 text-lg font-semibold text-emerald-900 hover:bg-emerald-50">
            Write a Letter of Support
          </a>
        </div>
      </div>
      <ImageSlot
        name="home/hero"
        alt="Enter-Great 313 community members together in Detroit"
        class="aspect-[4/5] w-full rounded-xl lg:justify-self-end"
      />
    </div>
  </section>

  {stats.length > 0 && (
    <section class="border-y border-stone-200 bg-white">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-3">
        {stats.map((stat) => (
          <div class="text-center">
            <p class="text-5xl font-extrabold tracking-tight text-emerald-800">{stat.value}</p>
            <p class="mt-2 font-semibold text-stone-700">{stat.label}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-3xl font-bold text-emerald-950">What we do</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.slice(0, 3).map((service) => (
        <div class="overflow-hidden rounded-lg border border-stone-200 bg-white">
          <ImageSlot
            name={`services/${service.slug}`}
            alt={service.title}
            class="aspect-square w-full"
          />
          <div class="p-5">
            <h3 class="text-lg font-bold text-emerald-950">{service.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-stone-600">{service.blurb}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="mt-8">
      <a href="/programs" class="font-semibold text-emerald-800 underline underline-offset-4">
        See our programs in detail
      </a>
    </div>
  </section>

  <section class="bg-emerald-950">
    <div class="mx-auto grid max-w-6xl items-center gap-8 px-4 py-14 lg:grid-cols-2">
      <ImageSlot
        name="home/meeting"
        alt="Flyer: Enter-Great313 weekly support group meetings for the justice impacted. Every Tuesday, 6:00–7:30 PM, 1010 Antietam lower level, Detroit MI 48207. Judgment-free zone, light refreshments. 313.444.9671"
        class="aspect-square w-full rounded-xl"
      />
      <div>
        <h2 class="text-3xl font-bold text-white">Tuesday nights, we're here.</h2>
        <p class="mt-4 max-w-md text-lg leading-relaxed text-emerald-100">
          Support group every Tuesday, 6:00–7:30 PM at 1010 Antietam, Detroit. Returning
          citizens, family, and supporters — everyone is welcome, no referral needed.
        </p>
        <a
          href="/events"
          class="mt-6 inline-block rounded-md bg-white px-6 py-3 font-bold text-emerald-950 hover:bg-emerald-100"
        >
          Come sit with us
        </a>
      </div>
    </div>
  </section>

  {featuredVideo && (
    <section class="mx-auto max-w-4xl px-4 py-16">
      <h2 class="text-3xl font-bold text-emerald-950">See the work</h2>
      <div class="mt-8">
        <VideoEmbed youtubeId={featuredVideo.data.youtubeId} title={featuredVideo.data.title} />
        <p class="mt-3 font-semibold">{featuredVideo.data.title}</p>
        {featuredVideo.data.description && <p class="text-stone-600">{featuredVideo.data.description}</p>}
      </div>
      <a href="/media" class="mt-6 inline-block font-semibold text-emerald-800 underline underline-offset-4">
        Watch more stories
      </a>
    </section>
  )}

  <section class="bg-stone-50">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-3xl font-bold text-emerald-950">Wear the mission</h2>
          <p class="mt-2 max-w-xl text-stone-700">
            Apparel for supporters — every purchase helps fund mentorship, meetings, and reentry support in Detroit.
          </p>
        </div>
        <a
          href={site.shopUrl || "/shop"}
          class="rounded-md border-2 border-emerald-800 px-5 py-2.5 font-semibold text-emerald-900 hover:bg-emerald-50"
        >
          {site.shopUrl ? "Visit the Store" : "Shop — coming soon"}
        </a>
      </div>
    </div>
  </section>

  <section class="bg-emerald-950">
    <div class="mx-auto max-w-4xl px-4 py-16 text-center">
      <h2 class="text-3xl font-bold text-white">“{quotes[1]}”</h2>
      <a
        href="/donate"
        class="mt-8 inline-block rounded-md bg-white px-8 py-3 text-lg font-bold text-emerald-950 hover:bg-emerald-100"
      >
        Join us — Donate
      </a>
    </div>
  </section>
</BaseLayout>
