---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, history } from "../data/site";
---

<BaseLayout
  title="Our History"
  description="The story of Enter-Great 313 — how a Detroit organization for returning citizens began and how it has grown."
>
  <section class="bg-stone-50">
    <div class="mx-auto max-w-4xl px-4 py-16">
      <h1 class="text-4xl font-extrabold tracking-tight text-emerald-950">Our history</h1>
      <p class="mt-6 text-lg leading-relaxed text-stone-700">
        How Enter-Great 313 started, and how it grew into the community it is today.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-12">
    {history.length > 0 ? (
      <ol class="relative border-l-2 border-emerald-800 pl-6">
        {history.map((entry) => (
          <li class="pb-10 last:pb-0">
            <span class="absolute -left-[9px] mt-2 h-4 w-4 rounded-full bg-emerald-800" />
            <p class="text-sm font-bold uppercase tracking-wide text-emerald-800">{entry.year}</p>
            <h2 class="mt-1 text-2xl font-bold text-emerald-950">{entry.title}</h2>
            <p class="mt-2 leading-relaxed text-stone-700">{entry.body}</p>
          </li>
        ))}
      </ol>
    ) : (
      <div class="rounded-lg border border-stone-200 bg-white p-8">
        <h2 class="text-2xl font-bold text-emerald-950">We're still writing this page.</h2>
        <p class="mt-3 leading-relaxed text-stone-700">
          The milestones, the people, and the meetings that built Enter-Great 313 are being put
          together now. In the meantime, the best way to know us is to show up on a Tuesday.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="/events"
            class="rounded-md bg-emerald-800 px-5 py-2.5 font-semibold text-white hover:bg-emerald-900"
          >
            See our weekly meeting
          </a>
          <a
            href={`tel:${site.phone}`}
            class="rounded-md border border-emerald-800 px-5 py-2.5 font-semibold text-emerald-900 hover:bg-emerald-50"
          >
            Call {site.phone}
          </a>
        </div>
      </div>
    )}
  </section>
</BaseLayout>
