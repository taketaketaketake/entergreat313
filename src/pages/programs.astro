---
import BaseLayout from "../layouts/BaseLayout.astro";
import ImageSlot from "../components/ImageSlot.astro";
import { getCollection, render } from "astro:content";

const programs = (await getCollection("programs")).sort(
  (a, b) => a.data.order - b.data.order,
);
const rendered = await Promise.all(
  programs.map(async (program) => ({ program, Content: (await render(program)).Content })),
);
---

<BaseLayout
  title="Reentry Programs: Mentorship, Life Skills & Job Training"
  description="Reentry programs for returning citizens in Detroit: free weekly support group meetings every Tuesday, and the six-week J.I.L.L. program covering counseling, digital skills, and financial rebuilding."
>
  <div class="mx-auto max-w-4xl px-4 py-16">
    <h1 class="text-4xl font-extrabold tracking-tight text-emerald-950">Programs</h1>
    <p class="mt-4 max-w-2xl text-lg text-stone-700">
      Built to help returning citizens rebuild their lives with guidance, encouragement, and real
      opportunities for growth.
    </p>
    <div class="mt-10 grid grid-cols-2 gap-3 sm:gap-6">
      {rendered.map(({ program, Content }) => (
        <section
          id={program.id}
          class="scroll-mt-24 overflow-hidden rounded-lg border border-stone-200 bg-white"
        >
          <ImageSlot
            name={`programs/${program.id}`}
            alt={program.data.title}
            class="aspect-[4/3] w-full sm:aspect-[3/2]"
          />
          <div class="p-3 sm:p-6">
            <h2 class="text-base font-bold leading-snug text-emerald-950 sm:text-2xl">
              {program.data.title}
            </h2>
            <p class="mt-1 hidden font-medium text-stone-600 sm:block">{program.data.summary}</p>
            <div class="prose prose-stone mt-2 max-w-none text-sm leading-relaxed sm:mt-4 sm:text-base">
              <Content />
            </div>
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
