---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, annualReports } from "../data/site";
---

<BaseLayout
  title="Annual Reports & Financials"
  description="Annual reports and financial information for Enter-Great 313, a Detroit nonprofit serving returning citizens."
>
  <section class="bg-stone-50">
    <div class="mx-auto max-w-4xl px-4 py-16">
      <h1 class="text-4xl font-extrabold tracking-tight text-emerald-950">
        Annual reports &amp; financials
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-stone-700">
        The people who support this work deserve to see where the money goes. Our reports are
        posted here as they're finished.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-12">
    {annualReports.length > 0 ? (
      <ul class="divide-y divide-stone-200 border-y border-stone-200">
        {annualReports.map((report) => (
          <li class="flex flex-wrap items-center justify-between gap-4 py-5">
            <div>
              <p class="text-sm font-bold uppercase tracking-wide text-emerald-800">
                {report.year}
              </p>
              <p class="mt-1 text-lg font-bold text-emerald-950">{report.title}</p>
              {report.note && <p class="mt-1 text-sm text-stone-600">{report.note}</p>}
            </div>
            <a
              href={report.file}
              class="rounded-md border border-emerald-800 px-5 py-2.5 font-semibold text-emerald-900 hover:bg-emerald-50"
            >
              Download PDF
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="rounded-lg border border-stone-200 bg-white p-8">
        <h2 class="text-2xl font-bold text-emerald-950">Reports are on the way.</h2>
        <p class="mt-3 leading-relaxed text-stone-700">
          We're preparing our reports for posting here. If you'd like our financial information
          before then — as a donor, a funder, or anyone who wants to look — ask us directly and
          we'll walk you through it.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={`tel:${site.phone}`}
            class="rounded-md bg-emerald-800 px-5 py-2.5 font-semibold text-white hover:bg-emerald-900"
          >
            Call {site.phone}
          </a>
          <a
            href="/contact"
            class="rounded-md border border-emerald-800 px-5 py-2.5 font-semibold text-emerald-900 hover:bg-emerald-50"
          >
            Contact us
          </a>
        </div>
      </div>
    )}
  </section>

  <section class="mx-auto max-w-4xl px-4 pb-12">
    <div class="rounded-lg bg-stone-50 p-6">
      <h2 class="text-lg font-bold text-emerald-950">Where your money goes</h2>
      <p class="mt-2 leading-relaxed text-stone-700">
        Donations fund the direct costs of reentry support: meeting space, refreshments,
        transportation, work clothes and interview prep, and the materials behind our life-skills
        and employment programs.
      </p>
      <a
        href="/donate"
        class="mt-4 inline-block font-semibold text-emerald-800 underline underline-offset-4"
      >
        Support the work
      </a>
    </div>
  </section>
</BaseLayout>
