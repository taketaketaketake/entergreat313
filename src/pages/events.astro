---
import BaseLayout from "../layouts/BaseLayout.astro";
import ImageSlot from "../components/ImageSlot.astro";
import { getCollection, render } from "astro:content";

const all = (await getCollection("events")).sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
);
const recurring = all.filter((e) => e.data.recurring);
const upcoming = all.filter((e) => !e.data.recurring && e.data.date >= new Date());
const rendered = await Promise.all(
  [...recurring, ...upcoming].map(async (event) => ({
    event,
    Content: (await render(event)).Content,
  })),
);

const eventSchema = [...recurring, ...upcoming].map((event) => ({
  "@context": "https://schema.org",
  "@type": "Event",
  name: event.data.title,
  startDate: event.data.date.toISOString(),
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: {
    "@type": "Place",
    name: event.data.location,
    address: event.data.address ?? event.data.location,
  },
  organizer: {
    "@type": "NGO",
    name: "Enter-Great 313",
    url: Astro.site?.toString(),
  },
  isAccessibleForFree: true,
  ...(event.data.recurring && {
    eventSchedule: {
      "@type": "Schedule",
      byDay: "https://schema.org/Tuesday",
      startTime: "18:00",
      endTime: "19:30",
      repeatFrequency: "P1W",
    },
  }),
}));
---

<BaseLayout
  title="Weekly Support Group Meetings in Detroit"
  description="Peer support group for returning citizens and justice-impacted people every Tuesday, 6:00–7:30 PM at 1010 Antietam, Detroit. Family and supporters welcome — no referral needed."
>
  <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />
  <div class="mx-auto max-w-4xl px-4 py-16">
    <h1 class="text-4xl font-extrabold tracking-tight text-emerald-950">Events</h1>
    <p class="mt-4 max-w-2xl text-lg text-stone-700">
      Everyone is welcome — returning citizens, family, and supporters. No referral needed.
    </p>
    <div class="mt-10 space-y-6">
      {rendered.map(({ event, Content }) => (
        <section class="overflow-hidden rounded-lg border border-stone-200">
          <ImageSlot
            name={`events/${event.id}`}
            alt={event.data.title}
            class="aspect-[5/2] w-full"
          />
          <div class="p-6">
          <h2 class="text-2xl font-bold text-emerald-950">{event.data.title}</h2>
          <p class="mt-1 font-medium text-stone-600">
            {event.data.recurring ??
              event.data.date.toLocaleString("en-US", { dateStyle: "long", timeStyle: "short" })}
            {event.data.endTime && !event.data.recurring ? ` – ${event.data.endTime}` : ""}
            {" · "}{event.data.address ?? event.data.location}
          </p>
          <div class="markdown mt-4 leading-relaxed text-stone-700">
            <Content />
          </div>
          </div>
        </section>
      ))}
    </div>
    <p class="mt-10 rounded-lg bg-stone-50 p-6 text-stone-700">
      Have a question about a meeting? Call
      <a href="tel:313-444-9671" class="font-semibold text-emerald-800 underline underline-offset-2">313-444-9671</a>.
    </p>
  </div>
</BaseLayout>
