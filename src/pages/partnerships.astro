---
import BaseLayout from "../layouts/BaseLayout.astro";
import { partners } from "../data/site";
---

<BaseLayout
  title="Partnerships"
  description="Enter-Great 313 partners with Detroit reentry organizations — FORC (Friends of Returning Citizens), RAKS and the J.I.L.L. Program, and Yard Line's family support directory."
>
  <div class="mx-auto max-w-4xl px-4 py-16">
    <h1 class="text-4xl font-extrabold tracking-tight text-emerald-950">Partnerships</h1>
    <p class="mt-4 max-w-2xl text-lg text-stone-700">
      Reentry takes a network. We work alongside Detroit organizations that share the mission.
    </p>
    <div class="mt-10 space-y-8">
      {partners.map((partner) => (
        <section class="rounded-lg border border-stone-200 p-6">
          <h2 class="text-xl font-bold text-emerald-950">{partner.name}</h2>
          <p class="mt-3 leading-relaxed text-stone-700">{partner.description}</p>
          <p class="mt-3 text-sm text-stone-600">
            {partner.url ? (
              <a href={partner.url} class="font-semibold text-emerald-800 underline underline-offset-2">
                {partner.details}
              </a>
            ) : (
              partner.details
            )}
          </p>
        </section>
      ))}
    </div>
    <p class="mt-10 rounded-lg bg-stone-50 p-6 text-stone-700">
      Interested in partnering with Enter-Great 313 — as an employer, a service provider, or a
      funder? <a href="/contact" class="font-semibold text-emerald-800 underline underline-offset-2">Reach out</a>.
    </p>
  </div>
</BaseLayout>
