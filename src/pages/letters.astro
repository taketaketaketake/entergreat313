---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Write a Letter of Support"
  description="Compose a personalized letter of support for a returning citizen — for parole boards, courts, or a loved one inside."
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-bold">Write a Letter of Support</h1>
    <p class="mt-4 text-neutral-700">
      Letters from family, employers, and community members carry real weight with parole
      boards and courts — when they're personal. This tool walks you through writing one,
      section by section, and gives you a finished letter ready to print and mail, with the
      right address and formatting.
    </p>
    <!-- Phase 2: letter builder island mounts here. Everything stays in your browser. -->
    <p class="mt-8 rounded border border-dashed border-neutral-300 p-4 text-sm text-neutral-500">
      The letter builder is coming soon.
    </p>
  </div>
</BaseLayout>
