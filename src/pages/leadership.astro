---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, leadership } from "../data/site";

const totalPeople = leadership.reduce((n, g) => n + g.people.length, 0);
---

<BaseLayout
  title="Leadership & Board of Directors"
  description="The people who lead Enter-Great 313 — an executive team, program leads, and a board that bring lived experience to reentry work in Detroit."
>
  <section class="bg-stone-50">
    <div class="mx-auto max-w-4xl px-4 py-16">
      <h1 class="text-4xl font-extrabold tracking-tight text-emerald-950">
        Leadership &amp; board
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-stone-700">
        {totalPeople} people guide this organization's vision, operations, and community
        partnerships. Nearly all of them carry the title <strong>Re-entry Specialist</strong> —
        not as a credential handed down from somewhere else, but because they have lived the
        transition they now help others make.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-12">
    {leadership.map((group) => (
      <div class="mb-12 last:mb-0">
        <h2 class="text-2xl font-bold text-emerald-950">{group.group}</h2>
        {group.blurb && <p class="mt-2 leading-relaxed text-stone-700">{group.blurb}</p>}
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {group.people.map((person) => (
            <li class="rounded-lg border border-stone-200 p-5">
              <p class="text-lg font-bold text-emerald-950">{person.name}</p>
              <p class="mt-1 text-sm font-semibold uppercase tracking-wide text-emerald-800">
                {person.role}
              </p>
              {person.bio && <p class="mt-3 leading-relaxed text-stone-700">{person.bio}</p>}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <section class="bg-stone-50">
    <div class="mx-auto max-w-4xl px-4 py-12">
      <h2 class="text-2xl font-bold text-emerald-950">Work with us</h2>
      <p class="mt-3 leading-relaxed text-stone-700">
        If you're a funder, a partner organization, or someone who wants to serve on this board,
        talk to us directly. We'd rather have the conversation than trade forms.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href={`tel:${site.phone}`}
          class="rounded-md bg-emerald-800 px-5 py-2.5 font-semibold text-white hover:bg-emerald-900"
        >
          Call {site.phone}
        </a>
        <a
          href="/partnerships"
          class="rounded-md border border-emerald-800 px-5 py-2.5 font-semibold text-emerald-900 hover:bg-emerald-50"
        >
          Partner with us
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
