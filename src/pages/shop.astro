---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Shop Second-Chance Apparel"
  description="Enter-Great 313 apparel and merch for supporters — every purchase funds mentorship, support meetings, and reentry services for returning citizens in Detroit."
>
  <div class="mx-auto max-w-4xl px-4 py-16">
    <h1 class="text-4xl font-extrabold tracking-tight text-emerald-950">Shop</h1>
    <p class="mt-4 max-w-2xl text-lg text-stone-700">
      Wear the mission. Every purchase funds mentorship, meetings, and reentry support in Detroit.
    </p>

    {site.shopUrl ? (
      <a
        href={site.shopUrl}
        class="mt-10 inline-block rounded-md bg-emerald-800 px-8 py-4 text-xl font-bold text-white hover:bg-emerald-700"
      >
        Visit the Store
      </a>
    ) : (
      <div class="mt-10 rounded-lg border border-dashed border-stone-300 p-8 text-stone-600">
        <p class="font-semibold text-stone-800">The store is coming soon.</p>
        <p class="mt-2">
          Apparel for supporters is in the works. In the meantime, the best way to help is a
          <a href="/donate" class="font-semibold text-emerald-800 underline underline-offset-2"> donation</a> —
          or come to a <a href="/events" class="font-semibold text-emerald-800 underline underline-offset-2">Tuesday meeting</a>.
        </p>
      </div>
    )}
  </div>
</BaseLayout>
