---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About">
  <div class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-bold">About Enter-Great 313</h1>
    <!-- Phase 1: migrate the org's story, mission, and testimonials from entergreat313.org -->
    <p class="mt-4 text-neutral-700">
      Enter-Great 313 helps people coming home from long-term incarceration make a real
      transition back into society — with peer support, mentorship, employment help, and
      community rooted in Detroit.
    </p>
  </div>
</BaseLayout>
