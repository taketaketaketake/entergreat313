---
import BaseLayout from "../layouts/BaseLayout.astro";
import VideoEmbed from "../components/VideoEmbed.astro";
import { site } from "../data/site";
import { getCollection } from "astro:content";

const featuredVideo = (await getCollection("videos"))
  .filter((v) => v.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
---

<BaseLayout
  title="Donate to Support Returning Citizens in Detroit"
  description="Your donation funds weekly peer support meetings, mentorship, job training, and practical reentry help for people coming home from incarceration in Detroit."
>
  <div class="mx-auto max-w-4xl px-4 py-16">
    <h1 class="text-4xl font-extrabold tracking-tight text-emerald-950">Donate</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-stone-700">
      Your support funds weekly peer meetings, mentorship, employment training, and the
      practical help — bus passes, clothing, paperwork, a person to call — that makes it
      possible to come home and stay home.
    </p>

    {featuredVideo && (
      <div class="mt-10">
        <VideoEmbed youtubeId={featuredVideo.data.youtubeId} title={featuredVideo.data.title} />
      </div>
    )}

    {site.donateUrl ? (
      <div class="mt-10">
        <a
          href={site.donateUrl}
          class="inline-block rounded-md bg-emerald-800 px-8 py-4 text-xl font-bold text-white hover:bg-emerald-700"
        >
          Donate Now
        </a>
        <p class="mt-3 text-sm text-stone-600">
          Donations are processed securely through GiveButter. You'll receive a receipt by email.
        </p>
      </div>
    ) : (
      <div class="mt-10 rounded-lg border border-dashed border-stone-300 p-8 text-stone-600">
        <p class="font-semibold text-stone-800">Online donations are moving to this page soon.</p>
        <p class="mt-2">
          For now, you can donate through the org's existing
          <a href="https://www.entergreat313.org/" class="font-semibold text-emerald-800 underline underline-offset-2">GiveButter campaign</a>,
          or contact us at <a href={`tel:${site.phone}`} class="font-semibold text-emerald-800 underline underline-offset-2">{site.phone}</a>.
        </p>
      </div>
    )}

    <section class="mt-14 grid gap-6 sm:grid-cols-3">
      <div class="rounded-lg bg-stone-50 p-5">
        <p class="text-lg font-bold text-emerald-950">Weekly meetings</p>
        <p class="mt-1 text-sm text-stone-700">Space, materials, and food for Tuesday support groups.</p>
      </div>
      <div class="rounded-lg bg-stone-50 p-5">
        <p class="text-lg font-bold text-emerald-950">Getting to work</p>
        <p class="mt-1 text-sm text-stone-700">Interview prep, work clothes, and transportation to jobs.</p>
      </div>
      <div class="rounded-lg bg-stone-50 p-5">
        <p class="text-lg font-bold text-emerald-950">First 90 days</p>
        <p class="mt-1 text-sm text-stone-700">IDs, phones, toiletries, and stability when it matters most.</p>
      </div>
    </section>

    <p class="mt-10 text-stone-700">
      Prefer to give another way? <a href="/shop" class="font-semibold text-emerald-800 underline underline-offset-2">Buy merch</a>,
      <a href="/letters" class="font-semibold text-emerald-800 underline underline-offset-2"> write a letter of support</a>, or
      <a href="/contact" class="font-semibold text-emerald-800 underline underline-offset-2"> get in touch about volunteering</a>.
    </p>
  </div>
</BaseLayout>
