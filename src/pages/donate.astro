---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title="Donate">
  <div class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-bold">Donate</h1>
    <p class="mt-4 text-neutral-700">
      Your support funds peer support meetings, employment training, and the practical help
      that makes it possible to come home and stay home.
    </p>
    <!-- Phase 1: embed the org's GiveButter campaign here (site.donateUrl) + featured video -->
    {site.donateUrl ? (
      <a href={site.donateUrl} class="mt-8 inline-block rounded bg-neutral-900 px-6 py-3 font-semibold text-white">
        Donate Now
      </a>
    ) : (
      <p class="mt-8 rounded border border-dashed border-neutral-300 p-4 text-sm text-neutral-500">
        GiveButter embed goes here — campaign URL needed from the org.
      </p>
    )}
  </div>
</BaseLayout>
