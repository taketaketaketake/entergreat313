---
import BaseLayout from "../layouts/BaseLayout.astro";
import { coreValues, missionPoints, goals } from "../data/site";
---

<BaseLayout
  title="Who We Are"
  description="Enter-Great 313 is a Detroit community organization supporting long-term-serving returning citizens with mentorship, life skills training, peer support, and second-chance employment help."
>
  <section class="bg-stone-50">
    <div class="mx-auto max-w-4xl px-4 py-16">
      <h1 class="text-4xl font-extrabold tracking-tight text-emerald-950">Our Mission</h1>
      <ul class="mt-6 space-y-3">
        {missionPoints.map((point) => (
          <li class="flex gap-3 text-lg leading-relaxed text-stone-700">
            <span aria-hidden="true" class="mt-2.5 h-2 w-2 shrink-0 rounded-full bg-emerald-800" />
            <span>{point}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-12">
    <h2 class="text-2xl font-bold text-emerald-950">Our Goals</h2>
    <p class="mt-3 leading-relaxed text-stone-700">
      No cost, no referral, no paperwork. Here is what we are trying to do.
    </p>
    <ol class="mt-8 space-y-6">
      {goals.map((goal, i) => (
        <li class="flex gap-4">
          <span class="mt-0.5 shrink-0 text-xl font-extrabold tabular-nums text-emerald-800">
            {i + 1}
          </span>
          <div>
            <p class="text-lg font-bold text-emerald-950">{goal.title}</p>
            <p class="mt-1 leading-relaxed text-stone-700">{goal.detail}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="bg-stone-50">
    <div class="mx-auto max-w-4xl px-4 py-12">
      <h2 class="text-2xl font-bold text-emerald-950">Values</h2>
      <ul class="mt-6 space-y-3">
        {coreValues.map((value) => (
          <li class="flex gap-3 leading-relaxed text-stone-700">
            <span aria-hidden="true" class="mt-2.5 h-2 w-2 shrink-0 rounded-full bg-emerald-800" />
            <span>
              <strong class="font-bold text-emerald-950">{value.name}</strong> — {value.description}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

</BaseLayout>
