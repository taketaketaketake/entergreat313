---
import "../styles/global.css";
import { site, nav } from "../data/site";

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.tagline } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | ${site.name}`} />
    <meta property="og:description" content={description} />
    <title>{title} | {site.name}</title>
  </head>
  <body class="min-h-screen bg-white font-sans text-stone-900 antialiased">
    <header class="sticky top-0 z-40 border-b border-stone-200 bg-white/95 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
        <a href="/" class="shrink-0 text-lg font-extrabold tracking-tight text-emerald-950">
          Enter-Great <span class="text-emerald-700">313</span>
        </a>

        <nav class="hidden items-center gap-x-5 text-[15px] font-medium lg:flex">
          {nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                "hover:text-emerald-800",
                currentPath === item.href ? "text-emerald-800 underline underline-offset-8" : "text-stone-700",
              ]}
            >
              {item.label}
            </a>
          ))}
          <a
            href="/donate"
            class="rounded-md bg-emerald-800 px-4 py-2 font-semibold text-white hover:bg-emerald-700"
          >
            Donate
          </a>
        </nav>

        <div class="flex items-center gap-3 lg:hidden">
          <a href="/donate" class="rounded-md bg-emerald-800 px-3 py-1.5 text-sm font-semibold text-white">
            Donate
          </a>
          <button
            id="menu-button"
            type="button"
            class="rounded-md border border-stone-300 px-3 py-1.5 text-sm font-medium"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            Menu
          </button>
        </div>
      </div>

      <nav id="mobile-menu" class="hidden border-t border-stone-200 bg-white px-4 pb-4 lg:hidden">
        {nav.map((item) => (
          <a href={item.href} class="block border-b border-stone-100 py-3 font-medium text-stone-800">
            {item.label}
          </a>
        ))}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-20 bg-emerald-950 text-emerald-100">
      <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:grid-cols-2 lg:grid-cols-3">
        <div>
          <p class="text-lg font-extrabold text-white">{site.name}</p>
          <p class="mt-2 max-w-xs text-sm leading-relaxed text-emerald-200">{site.tagline}</p>
        </div>
        <div class="text-sm">
          <p class="font-semibold text-white">Visit or call</p>
          <p class="mt-2">{site.address}</p>
          <p class="mt-1">
            <a href={`tel:${site.phone}`} class="hover:underline">{site.phone}</a>
          </p>
          <div class="mt-3 flex gap-4">
            <a href={site.socials.facebook} class="hover:underline">Facebook</a>
            <a href={site.socials.instagram} class="hover:underline">Instagram</a>
            {site.socials.youtube && <a href={site.socials.youtube} class="hover:underline">YouTube</a>}
          </div>
        </div>
        <div class="text-sm">
          <p class="font-semibold text-white">Take action</p>
          <div class="mt-2 flex flex-col gap-2">
            <a href="/donate" class="hover:underline">Donate</a>
            <a href="/letters" class="hover:underline">Write a letter of support</a>
            <a href="/shop" class="hover:underline">Shop</a>
            <a href="/events" class="hover:underline">Come to a meeting</a>
          </div>
        </div>
      </div>
      <div class="border-t border-emerald-900 py-4 text-center text-xs text-emerald-300">
        © {new Date().getFullYear()} {site.name} · Detroit, Michigan
      </div>
    </footer>

    <script>
      const button = document.getElementById("menu-button");
      const menu = document.getElementById("mobile-menu");
      button?.addEventListener("click", () => {
        const open = menu?.classList.toggle("hidden") === false;
        button.setAttribute("aria-expanded", String(open));
      });
    </script>
  </body>
</html>
