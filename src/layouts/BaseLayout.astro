---
import "../styles/global.css";
import { Image } from "astro:assets";
import logoIcon from "../assets/logo/icon.png";
import logoFull from "../assets/logo/enter-great-logo.png";
import { site, nav, footerNav } from "../data/site";

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.tagline } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

// Pages that include the org name provide their full title; others get " | Enter-Great 313"
const pageTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "NGO",
  name: site.name,
  alternateName: "Enter-Great313",
  description: site.mission,
  url: Astro.site?.toString(),
  logo: new URL("/favicon.png", Astro.site).toString(),
  telephone: site.phone,
  address: {
    "@type": "PostalAddress",
    streetAddress: "3127 E Canfield St",
    addressLocality: "Detroit",
    addressRegion: "MI",
    postalCode: "48207",
    addressCountry: "US",
  },
  areaServed: { "@type": "City", name: "Detroit" },
  sameAs: [site.socials.facebook, site.socials.instagram].filter(Boolean),
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#022c22" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </head>
  <body class="min-h-screen bg-white font-sans text-stone-900 antialiased">
    <header class="sticky top-0 z-40 border-b border-emerald-900 bg-emerald-950">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
        <a href="/" class="flex shrink-0 items-center gap-2.5">
          <Image src={logoIcon} alt="" width={72} class="h-9 w-auto" />
          <span class="text-lg font-extrabold tracking-tight text-white">
            Enter-Great <span class="text-emerald-300">313</span>
          </span>
        </a>

        <nav class="hidden items-center gap-x-5 text-[15px] font-medium lg:flex">
          {nav.map((item) =>
            item.menu ? (
              <div class="group relative" data-dropdown>
                <button
                  type="button"
                  data-dropdown-button
                  aria-expanded="false"
                  class:list={[
                    "flex items-center gap-1 py-2 hover:text-white",
                    item.menu.some((group) => group.items.some((link) => link.href === currentPath)) ||
                    currentPath === item.href
                      ? "text-white underline underline-offset-8"
                      : "text-emerald-100",
                  ]}
                >
                  {item.label}
                  <span aria-hidden="true" class="text-[10px] leading-none">▾</span>
                </button>
                <div
                  data-dropdown-panel
                  class="invisible absolute left-1/2 top-full z-50 w-max -translate-x-1/2 opacity-0 shadow-xl transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
                >
                  <div class="grid gap-x-12 gap-y-6 border-t-4 border-emerald-700 bg-emerald-900 px-8 py-7 sm:grid-cols-2">
                    {item.menu.map((group) => (
                      <div>
                        <p class="text-sm font-bold uppercase tracking-wide text-emerald-300">
                          {group.heading}
                        </p>
                        <ul class="mt-3 space-y-2.5">
                          {group.items.map((link) => (
                            <li>
                              <a
                                href={link.href}
                                class:list={[
                                  "block hover:text-white hover:underline underline-offset-4",
                                  currentPath === link.href ? "text-white" : "text-emerald-100",
                                ]}
                              >
                                {link.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={item.href}
                class:list={[
                  "hover:text-white",
                  currentPath === item.href ? "text-white underline underline-offset-8" : "text-emerald-100",
                ]}
              >
                {item.label}
              </a>
            ),
          )}
          <a
            href="/donate"
            class="rounded-md bg-white px-4 py-2 font-semibold text-emerald-950 hover:bg-emerald-100"
          >
            Donate
          </a>
        </nav>

        <div class="flex items-center gap-3 lg:hidden">
          <a href="/donate" class="rounded-md bg-white px-3 py-1.5 text-sm font-semibold text-emerald-950">
            Donate
          </a>
          <button
            id="menu-button"
            type="button"
            class="rounded-md border border-emerald-700 px-3 py-1.5 text-sm font-medium text-white"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            Menu
          </button>
        </div>
      </div>

      <nav id="mobile-menu" class="hidden border-t border-emerald-900 bg-emerald-950 px-4 pb-4 lg:hidden">
        {nav.map((item) => (
          <div class="border-b border-emerald-900 py-3">
            <a href={item.href} class="block font-medium text-emerald-100">{item.label}</a>
            {item.menu && (
              <div class="mt-3 space-y-4 border-l-2 border-emerald-800 pl-4">
                {item.menu.map((group) => (
                  <div>
                    <p class="text-xs font-bold uppercase tracking-wide text-emerald-300">
                      {group.heading}
                    </p>
                    <ul class="mt-1.5 space-y-1.5">
                      {group.items.map((link) => (
                        <li>
                          <a href={link.href} class="block py-1 text-[15px] text-emerald-100">
                            {link.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            )}
          </div>
        ))}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-20 bg-emerald-950 text-emerald-100">
      <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <a href="/">
            <Image src={logoFull} alt={`${site.name} — Assisted Transitioning`} width={480} class="h-auto w-56" />
          </a>
          <p class="mt-3 max-w-xs text-sm leading-relaxed text-emerald-200">{site.tagline}</p>
        </div>
        <div class="text-sm">
          <p class="font-semibold text-white">Visit or call</p>
          <p class="mt-2">{site.address}</p>
          <p class="mt-1">
            <a href={`tel:${site.phone}`} class="hover:underline">{site.phone}</a>
          </p>
          <div class="mt-3 flex gap-4">
            <a href={site.socials.facebook} class="hover:underline">Facebook</a>
            <a href={site.socials.instagram} class="hover:underline">Instagram</a>
            {site.socials.youtube && <a href={site.socials.youtube} class="hover:underline">YouTube</a>}
          </div>
        </div>
        <div class="text-sm">
          <p class="font-semibold text-white">Take action</p>
          <div class="mt-2 flex flex-col gap-2">
            <a href="/donate" class="hover:underline">Donate</a>
            <a href="/letters" class="hover:underline">Write a letter of support</a>
          </div>
        </div>
        <div class="text-sm">
          <p class="font-semibold text-white">More</p>
          <div class="mt-2 flex flex-col gap-2">
            {footerNav.map((item) => (
              <a href={item.href} class="hover:underline">{item.label}</a>
            ))}
          </div>
        </div>
      </div>
      <div class="border-t border-emerald-900 py-4 text-center text-xs text-emerald-300">
        © {new Date().getFullYear()} {site.name} · Detroit, Michigan
      </div>
    </footer>

    <script>
      const button = document.getElementById("menu-button");
      const menu = document.getElementById("mobile-menu");
      button?.addEventListener("click", () => {
        const open = menu?.classList.toggle("hidden") === false;
        button.setAttribute("aria-expanded", String(open));
      });

      // Desktop dropdowns open on hover/focus via CSS; this adds click-to-open for
      // touch and keyboard, since hover never fires on a tap.
      const dropdowns = document.querySelectorAll("[data-dropdown]");

      const closeAll = () => {
        dropdowns.forEach((dropdown) => {
          dropdown.querySelector("[data-dropdown-panel]")?.classList.add("invisible", "opacity-0");
          dropdown.querySelector("[data-dropdown-button]")?.setAttribute("aria-expanded", "false");
        });
      };

      dropdowns.forEach((dropdown) => {
        const trigger = dropdown.querySelector("[data-dropdown-button]");
        const panel = dropdown.querySelector("[data-dropdown-panel]");

        trigger?.addEventListener("click", (event) => {
          event.stopPropagation();
          const wasOpen = trigger.getAttribute("aria-expanded") === "true";
          closeAll();
          if (!wasOpen) {
            panel?.classList.remove("invisible", "opacity-0");
            trigger.setAttribute("aria-expanded", "true");
          }
        });

        dropdown.addEventListener("mouseleave", closeAll);
      });

      document.addEventListener("click", closeAll);
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeAll();
      });
    </script>
  </body>
</html>
